            <column caption='Total Transactions' datatype='integer' name='[Calculation_1627573243392000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Customer_ID])' />
            </column>
            <column caption='Total Transaction Volume' datatype='real' default-format='*₹ #,##,##0;₹ -#,##,##0' name='[Calculation_1627573244006401]' role='measure' type='quantitative'>
